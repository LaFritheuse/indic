# Copier ce fichier en ".env" (même dossier) et renseigner les vraies
# valeurs. Ce fichier .env n'est JAMAIS commité (voir .gitignore) --
# c'est le fichier ".env.example" (celui-ci, sans vraies valeurs) qui
# est versionné pour documenter les variables nécessaires.
#
# Chargé automatiquement par tous les scripts de data_collection/ (via
# python-dotenv) quand ils tournent en local -- sans effet sur GitHub
# Actions, où les secrets arrivent déjà comme variables d'environnement.

# Projet Supabase (Settings > API dans le dashboard Supabase)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=colle-ici-ta-cle-supabase

# Clé API Coinalyze (https://coinalyze.net -- compte > API), utilisée
# par collect_liquidations.py et collect_long_short_ratio.py (via
# coinalyze_client.py). Note : le nom de variable est bien
# "COINALIZE_API_KEY" (sans le Y de "Coinalyze"), pas une faute de
# frappe -- c'est le nom exact utilisé dans le code et le secret GitHub.
COINALIZE_API_KEY=colle-ici-ta-cle-coinalyze
